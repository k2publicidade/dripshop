  "interactions": {
    "header": {
      "sticky": true,
      "sticky_background": "#080808",
      "hide_announcement_on_scroll": true
    },
    "hero": {
      "slider": true,
      "slides": 3,
      "autoplay": true,
      "autoplay_interval_ms": 6000
    },
    "products": {
      "carousel": true,
      "swipe": true,
      "arrows_desktop": true,
      "quick_wishlist": true
    },
    "animations": {
      "type": "subtle",
      "allowed": [
        "fade_in",
        "slide_up_12px",
        "image_zoom_hover",
        "arrow_translate"
      ],
      "avoid": [
        "excessive_parallax",
        "bounce",
        "heavy_3d",
        "glitch",
        "random_motion"
      ]
    }
  },

  "responsive": {
    "desktop": {
      "breakpoint": ">=1200px",
      "hero": "full_width",
      "artists_per_row": 4,
      "products_per_view": 5,
      "categories_per_row": 6
    },

    "tablet": {
      "breakpoint": "768px-1199px",
      "menu": "compact",
      "hero": "image_with_overlay",
      "artists_per_row": 2,
      "products_per_view": 3,
      "categories_per_row": 3,
      "footer_columns": 3
    },

    "mobile": {
      "breakpoint": "<768px",
      "header": {
        "height": "72px",
        "menu": "hamburger",
        "logo": "center",
        "actions": [
          "search",
          "cart"
        ]
      },
      "hero": {
        "height": "620px-720px",
        "layout": "full_bleed_image",
        "text_overlay": true,
        "headline_size": "48px-60px",
        "cta_full_width": false
      },
      "artists": {
        "type": "horizontal_scroll",
        "card_width": "78vw"
      },
      "products": {
        "type": "horizontal_scroll",
        "card_width": "72vw"
      },
      "categories": {
        "columns": 2
      },
      "editorial_and_newsletter": {
        "layout": "stacked"
      },
      "footer": {
        "layout": "accordion"
      }
    }
  },

  "seo_content": {
    "homepage_title": "DripShop | Streetwear oficial de artistas do Rap e Funk",
    "meta_description": "Streetwear exclusivo inspirado na cultura brasileira. Coleções oficiais de artistas do RAP e FUNK, camisetas, moletons, bonés e acessórios.",
    "keywords": [
      "streetwear brasil",
      "roupa rap",
      "roupa funk",
      "merch artistas",
      "TZ da Coronel",
      "MC Lan",
      "MC Poze do Rodo",
      "camiseta streetwear",
      "moletom streetwear",
      "DripShop"
    ]
  },

  "accessibility": {
    "minimum_contrast_ratio": "4.5:1",
    "minimum_body_font_mobile": "16px",
    "buttons_min_height": "44px",
    "keyboard_navigation": true,
    "visible_focus": true,
    "alt_text_required": true,
    "avoid_text_inside_images_when_possible": true
  },

  "performance": {
    "hero_image_format": "AVIF/WebP",
    "product_image_format": "WebP",
    "lazy_load": true,
    "preload": [
      "logo",
      "hero_first_image",
      "primary_font"
    ],
    "target_lcp": "<2.5s",
    "target_cls": "<0.1"
  },

  "content_guidelines": {
    "tone": [
      "urbano",
      "direto",
      "autêntico",
      "brasileiro",
      "premium sem ser elitista"
    ],
    "preferred_phrases": [
      "Da rua pro mundo.",
      "Mais que roupa, é cultura.",
      "Moda que vem da realidade.",
      "Peças exclusivas. Direto da cena.",
      "Vista o que te move.",
      "Do estúdio pra sua rua."
    ],
    "avoid": [
      "gírias forçadas",
      "texto excessivamente publicitário",
      "termos genéricos de moda",
      "frases que pareçam geradas automaticamente",
      "excesso de elementos decorativos"
    ]
  },

  "implementation_notes": {
    "recommended_structure": [
      "AnnouncementBar",
      "Header",
      "Hero",
      "ArtistShowcase",
      "BenefitsBar",
      "ProductCarousel",
      "CollectionCampaign",
      "CategoryGrid",
      "EditorialVideo",
      "Newsletter",
      "Footer"
    ],
    "recommended_stack": {
      "frontend": "Next.js / React",
      "styling": "Tailwind CSS ou CSS Modules",
      "commerce": "Shopify Storefront API, Nuvemshop API ou backend próprio",
      "cms": "Sanity, Strapi ou Shopify CMS",
      "images": "Cloudinary ou Next Image",
      "analytics": [
        "Google Analytics 4",
        "Meta Pixel",
        "TikTok Pixel"
      ]
    }
  }
