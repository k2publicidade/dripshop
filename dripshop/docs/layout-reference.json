{
  "project": {
    "name": "DRIPSHOP",
    "type": "ecommerce_streetwear",
    "market": "Brasil",
    "language": "pt-BR",
    "positioning": "Loja de streetwear com produtos exclusivos e coleções ligadas a artistas da cena brasileira de RAP e FUNK.",
    "creative_direction": {
      "style": [
        "streetwear premium",
        "editorial",
        "urbano",
        "musical",
        "cultura de rua",
        "cinematográfico",
        "minimalista",
        "alto impacto visual"
      ],
      "mood": [
        "autêntico",
        "forte",
        "underground",
        "contemporâneo",
        "aspiracional",
        "exclusivo"
      ],
      "design_principles": [
        "evitar aparência genérica de template",
        "priorizar fotografia editorial de artistas",
        "usar tipografia condensada e forte",
        "manter áreas brancas para respiro",
        "alternar seções claras e escuras",
        "reduzir o número de ícones",
        "evitar caixas excessivas",
        "não utilizar texturas granuladas artificiais",
        "evitar contrastes estourados",
        "evitar fontes com aspecto de pincelada quando o texto precisar de alta legibilidade",
        "usar elementos manuscritos apenas como detalhe gráfico",
        "manter hierarquia tipográfica evidente",
        "priorizar experiência de compra e descoberta de artistas"
      ]
    }
  },

  "brand": {
    "name": "DRIPSHOP",
    "logo": {
      "primary": "DRIPSHOP",
      "secondary_text": "STREETWEAR | BRASIL",
